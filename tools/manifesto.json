".dockerignore": "node_modules\nrenv/library\n.git\nreferences\ndocs\ntests\ntaiga-design-system\n*.db\n.Renviron\n.secrets\ndist\n",
".env.exemplo": "# Copy to .env (Docker) or .Renviron (R). Never commit the real file.\nCOMERHOJE_DB=/data/comerhoje.db\nCOMERHOJE_TZ=America/Sao_Paulo\nCOMERHOJE_FRAMEWORK=lumen\n# Google Sheet via the sheet's own Apps Script (reads and writes) - inst/apps-script/Code.gs\nCOMERHOJE_PLANILHA_SCRIPT=https://script.google.com/macros/s/XXXX/exec\nCOMERHOJE_PLANILHA_TOKEN=troque-por-uma-senha-longa\n# or: link-shared sheet, read-only (restores the stock on a cold start)\n# COMERHOJE_PLANILHA_ID=1AbC...\n# Cloud vision (optional; only when the device is unsure)\n# COMERHOJE_VISAO_PROVEDOR=anthropic\n# COMERHOJE_VISAO_API_KEY=...\n# COMERHOJE_VISAO_MODELO=...   (a multimodal model of your provider)\n",
".github/workflows/ci.yml": "name: ci\non: [push, pull_request]\njobs:\n  frontend-e-paridade:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: 22 }\n      - uses: actions/setup-python@v5\n        with: { python-version: \"3.12\" }\n      - run: npm ci --ignore-scripts\n      - run: node tools/build.mjs --html-ocr\n      - run: pip install playwright pillow && python -m playwright install --with-deps chromium\n      - run: python3 tools/verificar.py            # every suite; fails if any fails\n      - uses: actions/upload-artifact@v4\n        with: { name: comerhoje-html, path: inst/standalone/comerhoje.html }\n  r:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: 22 }\n      - run: npm ci --ignore-scripts && node tools/build.mjs\n      - uses: r-lib/actions/setup-r@v2\n        with: { r-version: \"4.6\" }\n      - uses: r-lib/actions/setup-r-dependencies@v2\n        with: { extra-packages: \"any::testthat, any::rcmdcheck, any::roxygen2, any::pkgload\" }\n      - run: Rscript -e 'roxygen2::roxygenise()'          # man/ and NAMESPACE from the roxygen comments\n      - run: Rscript -e 'pkgload::load_all(); testthat::test_dir(\"tests/testthat\", stop_on_failure = TRUE)'\n      # R CMD check on the built tarball (.Rbuildignore applies). Expected: 0 errors, 0 warnings, 1 NOTE\n      # (installed size: the on-device reader's OCR models in inst/app/www/ocr, ~30 MB).\n      - uses: r-lib/actions/check-r-package@v2\n        with: { args: 'c(\"--no-manual\")', error-on: '\"warning\"', check-dir: '\"check\"' }\n",
".gitignore": ".Rproj.user\n.Rhistory\n.RData\n.Ruserdata\n.Renviron\n.secrets/\n__MACOSX/\n.DS_Store\nnode_modules/\n*.db\n*.db-wal\n*.db-shm\n# generated by `node tools/build.mjs` (OCR models: ~30 MB; rebuilt in the Docker image / before deploying)\ninst/app/www/ocr/\ndist/\n*-service-account*.json\n.env\ncomerHoje.Rcheck/\n*.tar.gz\n00check.log\n"
}
}
