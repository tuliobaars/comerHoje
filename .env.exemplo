# Copy to .env (Docker) or .Renviron (R). Never commit the real file.
COMERHOJE_DB=/data/comerhoje.db
COMERHOJE_TZ=America/Sao_Paulo
COMERHOJE_FRAMEWORK=lumen
# Google Sheet via the sheet's own Apps Script (reads and writes) - inst/apps-script/Code.gs
COMERHOJE_PLANILHA_SCRIPT=https://script.google.com/macros/s/XXXX/exec
COMERHOJE_PLANILHA_TOKEN=troque-por-uma-senha-longa
# or: link-shared sheet, read-only (restores the stock on a cold start)
# COMERHOJE_PLANILHA_ID=1AbC...
# Cloud vision (optional; only when the device is unsure)
# COMERHOJE_VISAO_PROVEDOR=anthropic
# COMERHOJE_VISAO_API_KEY=...
# COMERHOJE_VISAO_MODELO=...   (a multimodal model of your provider)
